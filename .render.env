# Render Deployment Environment Variables
# Copy this to your Render dashboard environment variables

# Database (Render provides this automatically)
# DATABASE_URL=postgresql://...

# MongoDB Atlas (Get free tier from mongodb.com)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/healthcare_db

# Redis (Optional - can be disabled for free tier)
REDIS_URL=redis://localhost:6379

# OpenAI API (Optional - uses keyword fallback if not provided)
OPENAI_API_KEY=your_openai_api_key_here

# Security
SECRET_KEY=your_secret_key_generate_with_openssl

# Feature Flags for Free Tier Optimization
ENABLE_ML_MODELS=false
ENABLE_OCR=false
ENABLE_RAG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24